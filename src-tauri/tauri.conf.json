{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Unfuse",
  "version": "1.0.0",
  "identifier": "com.unfuse.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Unfuse",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "label": "main",
        "decorations": true,
        "fullscreen": false,
        "transparent": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "runtime/unfuse-srt"
    ],
    "resources": {
      "runtime/vendor/": "runtime/vendor/",
      "runtime/THIRD_PARTY_NOTICES.txt": "runtime/THIRD_PARTY_NOTICES.txt"
    }
  }
}
